# Copy to `.env` in this directory (gitignored) and fill in.
# Homelab: no website/ folder needed — this file is enough.
#
#   ./requirements.sh
#   edit this file
#   ./install.sh
#   ./studio up            # agent (worker + preview); start clients from Admin

# --- Imagine client (Wine) ---
# Path to the game folder you SCP'd beside deploy-studio (or anywhere).
PORTRAIT_CLIENT_DIR=/home/foo/reimagine
# PORTRAIT_CLIENT_EXE=ImagineClient.exe
# PORTRAIT_WINE=wine
# WINEPREFIX=

# --- Mannequin logins (accounts; chars are usually vam / vaf) ---
PORTRAIT_VAM1_USER=vam1
PORTRAIT_VAM1_PASS=
PORTRAIT_VAF1_USER=vaf1
PORTRAIT_VAF1_PASS=

# --- Channel studio API (channel binds 0.0.0.0:StudioHttpPort; auth = StudioToken) ---
# Homelab: use the channel host LAN/Tailscale IP (same machine as game server).
PORTRAIT_STUDIO_URL=http://192.168.0.40:14700
PORTRAIT_STUDIO_TOKEN=dev-studio-token-change-me

# --- Website queue HTTP (website host — NOT 127.0.0.1 if this is a remote Wine PC) ---
# Use the LAN/Tailscale IP of the machine running the Next website.
PORTRAIT_QUEUE_URL=http://192.168.0.40:3500
# Prefer dedicated worker token; falls back to PORTRAIT_STUDIO_TOKEN
# PORTRAIT_WORKER_TOKEN=

# --- Preview agent (this host; website Snap via PORTRAIT_PREVIEW_URL) ---
# PORTRAIT_PREVIEW_PORT=14701
# PORTRAIT_PREVIEW_HOST=0.0.0.0

# --- X11 (required for Wine). SSH/headless: use Xvfb on :99 ---
# PORTRAIT_XVFB_DISPLAY=:99
# PORTRAIT_XVFB_SCREEN=1920x1080x24
# PORTRAIT_SKIP_WM=1
# PORTRAIT_KEEP_DPMS=1          # leave X screensaver/DPMS on (default: off)
# PORTRAIT_SKIP_IDLE_NUDGE=1    # skip mouse wiggle that keeps Wine GL awake
# PORTRAIT_SKIP_WM=1
# PORTRAIT_KEEP_DPMS=1          # leave X screensaver/DPMS on (default: off)
# PORTRAIT_SKIP_IDLE_NUDGE=1    # skip mouse wiggle that keeps Wine GL awake
DISPLAY=:99
# PORTRAIT_XVFB_DISPLAY=:99
# PORTRAIT_XVFB_SCREEN=1920x1080x24
# Optional WM (openbox) auto-started when present — helps focus

# --- In-game keys (Wine SendInput; built by ./requirements.sh) ---
# xdotool cannot drive DirectInput; portrait-sendinput.exe is required for
# hold-S / Home / PageUp.
# PORTRAIT_SENDINPUT_EXE=/path/to/portrait-sendinput.exe
# PORTRAIT_HOLD_S_SEC=2.0
# PORTRAIT_CAM_HOME_SEC=1.1
# PORTRAIT_CAM_PGUP_SEC=0.5

# --- Optional ---
# PORTRAIT_MANNEQUIN_M=vam1
# PORTRAIT_MANNEQUIN_F=vaf1
# PORTRAIT_DISCORD_WEBHOOK=          # optional direct Discord; prefer Admin Watchdog webhook via /api/portrait/alert
# PORTRAIT_WATCH=vam1,vaf1
# PORTRAIT_WATCH_INTERVAL=30
# PORTRAIT_WATCH_OFFLINE_SEC=45
# PORTRAIT_WATCH_RELOG_TRIES=2
# PORTRAIT_WATCH_RECOVER=1
