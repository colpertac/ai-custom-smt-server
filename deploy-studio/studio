#!/usr/bin/env bash
# Preferred entry for deploy-studio.
# Usage: ./studio [check|ping|up|down|orch-up|status|debug-snap|menu|…]
#   up/down = agent (worker + preview). Clients: orch-up / Admin UI / down --clients
set -euo pipefail
cd "$(dirname "$0")"

CMD="${1:-menu}"

if [[ "$CMD" == "check" ]]; then
  exec bash ./install.sh
fi

# Lightweight token handshake — no Wine / Imagine (forwards args to agent).
if [[ "$CMD" == "ping" ]]; then
  shift || true
  if command -v uv >/dev/null 2>&1; then
    if [[ ! -d .venv ]]; then
      echo "creating venv (uv sync)…"
      uv sync
    fi
    exec uv run python portrait-ping-agent.py "$@"
  fi
  if [[ -x .venv/bin/python ]]; then
    exec .venv/bin/python portrait-ping-agent.py "$@"
  fi
  echo "error: need uv or .venv — run ./requirements.sh" >&2
  exit 1
fi

if [[ ! -f .env && -f .env.example ]]; then
  echo "note: no .env yet — copy .env.example → .env and set PORTRAIT_CLIENT_DIR / passwords" >&2
fi

if command -v uv >/dev/null 2>&1; then
  if [[ ! -d .venv ]]; then
    echo "creating venv (uv sync)…"
    uv sync
  fi
  exec uv run python portrait-cli.py "$@"
fi

if [[ -x .venv/bin/python ]]; then
  exec .venv/bin/python portrait-cli.py "$@"
fi

echo "error: need uv (https://docs.astral.sh/uv/) or an existing .venv/" >&2
echo "→ run ./requirements.sh" >&2
exit 1
