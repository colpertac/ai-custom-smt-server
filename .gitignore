# Scratch and extracted editable client source (proprietary)
work/
client-source/BinaryData/

# Proprietary/extracted client data
client-overlay/BinaryData/
client-overlay/Event/
client-overlay/Map/
client-overlay/Avatar/
client-overlay/Devil/
client-overlay/NPC/
client-overlay/effect/
client-overlay/sound/
client-overlay/*.exe
client-overlay/*.dll
client-overlay/*.dat
client-overlay/*.sdat*

# Generated translation and updater output
translation/build/
translation/**/*.bin
translation/**/*.sbin
updater/base/
updater/overlay/
updater/**/*.compressed
updater/**/hashlist.dat

# Built packages are tracked so installs stay reproducible.
# Keep staging leftovers out of git.
server-content/packages/*.tmp
server-content/packages/stage/

# Local server state
database/
logs/
.env
.env.*
!.env.example

# Common build/editor output
build/
node_modules/
.next/
dist/
__pycache__/
*.pyc
.DS_Store

