<?xml version="1.0" encoding="UTF-8"?>
<config>
    <!-- Matches Reimagine/private-server defaults used before Phase 9.
         User overrides from updater Settings land here and take precedence
         over comp_client.xml. -->
    <patch name="noWebAuth">apply</patch>
    <patch name="customPackets">apply</patch>
    <patch name="updaterCheck">skip</patch>
</config>
