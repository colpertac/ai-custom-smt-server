# Copy to updater/config.env and adjust.

# Full-catalog mode only (optional). Prefer: ./scripts/seed-updater-base.sh --overlay-only
UPDATER_BASE_SOURCE=/home/cat/software/smt/game/reimagine/ImagineUpdate2.dat

# comp_rehash and rsync targets (defaults match this repo layout)
UPDATER_ROOT=/home/cat/repos/smt/ai_custom_smt_server/updater
CLIENT_OVERLAY=/home/cat/repos/smt/ai_custom_smt_server/client-overlay
BIN_DIR=/home/cat/repos/smt/comp_hack/build-current/bin

# Local HTTP serve (Python) / Docker uses UPDATER_PORT on host
UPDATER_PORT=8765
UPDATER_BIND=127.0.0.1
