# Lobby REST API (keep private; never expose to the browser)
COMP_API_URL=http://127.0.0.1:10999

# 32+ byte secret used to seal the web session cookie
SESSION_SECRET=replace-with-openssl-rand-base64-48

# Phase 16A — public portal / hardening
SITE_URL=http://127.0.0.1:3500
# COOKIE_SECURE=false
# PUBLIC_UPDATER_URL=http://127.0.0.1:8765
# UPDATER_PROBE_URL=http://127.0.0.1:8765
# LOBBY_PROBE_HOST=127.0.0.1
# CHANNEL_PROBE_HOST=127.0.0.1

# Resend (transactional email) — server-only; never NEXT_PUBLIC_*
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=noreply@example.com
# RESEND_FROM_NAME=SMT
# RESEND_SUPPORT_EMAIL=noreply@example.com

# Same value must be set on the lobby process for password-reset APIs
# COMP_RESET_SECRET=openssl-rand-hex-32

# Phase 16C — COMP shop working copy (default: ../server-content/shops)
# COMP_SHOPS_DIR=/path/to/server-content/shops
# SHOP_PRODUCTS_PATH=/path/to/shop-products.json

# Phase 16D — dungeon payout working copy (default: ../server-content/payouts)
# COMP_PAYOUTS_DIR=/path/to/server-content/payouts

# Phase 16I — ops sidecar (localhost only; website BFF proxies /api/admin/ops/*)
# Start: pnpm run ops-sidecar  (from website/, needs OPS_TOKEN)
# OPS_URL=http://127.0.0.1:14710
# OPS_TOKEN=dev-ops-token-change-me
# OPS_BACKEND=native
# OPS_COMP_SCRIPTS=/path/to/comp_hack/scripts
# OPS_COMPOSE_DIR=/path/to/ai_custom_smt_server/deploy

# Phase 16E — read-only world SQLite for public character armory
# COMP_WORLD_DB=/path/to/comp_hack/runtime/database/world.sqlite3
# Read-only lobby Account DB (username → UID for admin character list)
# COMP_LOBBY_DB=/path/to/comp_hack/runtime/database/comp_hack.sqlite3

# Portrait studio (channel; server-only — used by admin BFF + worker)
# PORTRAIT_STUDIO_URL=http://127.0.0.1:14700
# PORTRAIT_STUDIO_TOKEN=dev-studio-token-change-me
# Homelab preview agent (Wine host). Admin Snap POSTs here for screenshots.
# PORTRAIT_PREVIEW_URL=http://192.168.0.230:14701
# Remote worker HTTP queue (/api/portrait/queue/*). Prefer a dedicated secret;
# if unset, PORTRAIT_STUDIO_TOKEN is accepted as fallback.
# PORTRAIT_WORKER_TOKEN=dev-worker-token-change-me
# Header: X-Portrait-Worker-Token: <token>
# Incoming Discord webhook for portrait-watchdog (never commit the real URL)
# PORTRAIT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/ID/TOKEN
# PORTRAIT_WATCH=vam1
# PORTRAIT_WATCH_INTERVAL=30
# PORTRAIT_WATCH_OFFLINE_SEC=60
