#!/usr/bin/env bash
# Homelab / scripts-only entry — uses uv venv + .env (no website/ or npm).
# Usage: ./portrait-cli [status|menu|…]
set -euo pipefail
cd "$(dirname "$0")"

if [[ ! -f .env && -f .env.example ]]; then
  echo "note: no .env yet — copy .env.example → .env and set PORTRAIT_CLIENT_DIR / passwords" >&2
fi

if command -v uv >/dev/null 2>&1; then
  if [[ ! -d .venv ]]; then
    echo "creating venv (uv sync)…"
    uv sync
  fi
  exec uv run python portrait-cli.py "$@"
fi

# Fallback when uv is not on PATH (venv already created elsewhere).
if [[ -x .venv/bin/python ]]; then
  exec .venv/bin/python portrait-cli.py "$@"
fi

echo "error: need uv (https://docs.astral.sh/uv/) or an existing .venv/" >&2
exit 1
