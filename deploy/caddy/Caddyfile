{
	# Allow multi‑GB admin zip bodies (default is already unlimited, but be explicit).
	servers {
		timeouts {
			read_body 2h
			read_header 1m
			write 2h
			idle 2h
		}
		# HTTP/3 (QUIC) can stall long browser uploads; stick to H1/H2.
		protocols h1 h2
	}
}

{$DOMAIN} {
	# Always allow the maintenance status probe (even when ENABLED is set).
	handle /.maintenance-status {
		root * /srv/maintenance
		rewrite * /status.txt
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store"
		file_server
	}

	# Lane C / ops sets ENABLED while a stack update is running.
	@maint {
		file {
			root /srv/maintenance
			try_files /ENABLED
		}
	}
	handle @maint {
		root * /srv/maintenance
		rewrite * /index.html
		header Cache-Control "no-store"
		file_server
	}

	# Large admin zip ingest: long upstream timeouts, unbuffered proxy.
	handle /api/admin/ops/ingest/zip* {
		reverse_proxy website:3000 {
			transport http {
				read_timeout 2h
				write_timeout 2h
				response_header_timeout 2h
				dial_timeout 30s
			}
			flush_interval -1
		}
	}

	# Client updater files (hashlist, packages, patches)
	handle /files/* {
		encode zstd gzip
		reverse_proxy updater:80
	}

	# Next.js website portal
	handle {
		encode zstd gzip
		reverse_proxy website:3000 {
			# Fail fast so handle_errors can show maintenance HTML.
			transport http {
				dial_timeout 3s
			}
		}
	}

	# Website down / restarting → static maintenance page (not a bare 502).
	handle_errors 502 503 504 {
		root * /srv/maintenance
		rewrite * /index.html
		header Cache-Control "no-store"
		file_server
	}
}
