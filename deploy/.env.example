# Client-facing IP/hostname for channel ExternalIP (required for remote play).
EXTERNAL_IP=127.0.0.1

# Website BFF session seal (required). Generate: openssl rand -base64 48
SESSION_SECRET=replace-with-openssl-rand-base64-48

# Ops sidecar token (required). Website proxies admin ops here — keep secret.
# Generate: openssl rand -hex 24
OPS_TOKEN=replace-with-ops-token

# Absolute path to updater tree (site + overlay + base).
# install.sh / install.ps1 set this to <deploy>/updater by default.
UPDATER_ROOT=/home/cat/repos/smt/ai_custom_smt_server/updater

# Website writable data (sqlite, config/shops/payouts working copies).
# WEBSITE_DATA=./website-data

# Absolute host paths required when ops runs `docker compose` (relative
# paths resolve to /compose/... on the host and Docker creates directories).
# COMP_ENTRYPOINT=/home/smt/deploy/entrypoint.sh
# OPS_HOST_DEPLOY_DIR=/home/smt/deploy

# Hub images (override to pin a dated tag if needed)
COMP_IMAGE=colpertac/smt-comp:latest
WEBSITE_IMAGE=colpertac/smt-website:latest
# OPS_IMAGE=colpertac/smt-ops:latest

# Host dir with Linux amd64 tools (mounted read-only at /opt/comp-tools):
#   comp_rehash, comp_encrypt, comp_decrypt, comp_bdpatch
# Required for Lane B, Client prep, and custom Dungeon loot NPC dialog labels.
# Copy/symlink from comp_hack/build-localdeps-v31/bin (or your build).
# OPS_TOOLS_DIR=./ops-tools

# Published ports
# WEBSITE_PORT=3080   # default 3000; use 3080 if host next dev holds 3000
# UPDATER_PORT=8765
# LOBBY_PORT=10666
# CHANNEL_PORT=14666
# Lobby API bound to loopback on host (website uses lobby:10999 on bridge)
# LOBBY_HTTP_BIND=127.0.0.1
# LOBBY_HTTP_PORT=10999

# COMP_API_URL=http://lobby:10999
# MARIADB_ROOT_PASSWORD=smt_root_change_me

# Phase 16A website portal
# SITE_URL=http://132.145.140.16:3000
# COOKIE_SECURE=false
# PUBLIC_UPDATER_URL=http://132.145.140.16:8765
# UPDATER_PROBE_URL=http://updater
# OPS_URL=http://ops:14710

# Password reset + welcome email (optional). install.sh generates COMP_RESET_SECRET.
# Same COMP_RESET_SECRET must reach lobby (x-comp) and website containers.
# COMP_RESET_SECRET=
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=noreply@yourdomain.com
# RESEND_FROM_NAME=Your Realm
# RESEND_SUPPORT_EMAIL=noreply@yourdomain.com
