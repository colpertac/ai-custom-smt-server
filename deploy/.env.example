# Client-facing IP/hostname for channel ExternalIP (required for remote play).
EXTERNAL_IP=127.0.0.1

# Website BFF session seal (required). Generate: openssl rand -base64 48
SESSION_SECRET=replace-with-openssl-rand-base64-48

# Absolute path to ai_custom_smt_server/updater (site + overlay + base)
UPDATER_ROOT=/home/cat/repos/smt/ai_custom_smt_server/updater

# Hub images (override to pin a dated tag if needed)
COMP_IMAGE=colpertac/smt-comp:latest
WEBSITE_IMAGE=colpertac/smt-website:latest

# Published ports
# WEBSITE_PORT=3080   # default 3000; use 3080 if host next dev holds 3000
# UPDATER_PORT=8765
# LOBBY_PORT=10666
# CHANNEL_PORT=14666
# Lobby API bound to loopback on host (website uses lobby:10999 on bridge)
# LOBBY_HTTP_BIND=127.0.0.1
# LOBBY_HTTP_PORT=10999

# COMP_API_URL=http://lobby:10999
# MARIADB_ROOT_PASSWORD=smt_root_change_me

# Phase 16A website portal
# SITE_URL=http://132.145.140.16:3000
# COOKIE_SECURE=false
# PUBLIC_UPDATER_URL=http://132.145.140.16:8765
# UPDATER_PROBE_URL=http://updater
